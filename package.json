{
  "name": "lyra",
  "version": "0.1.0",
  "description": "A feature-rich Discord bot written TypeScript inspired by Ree6",
  "homepage": "https://github.com/discowd-nitwo/Lyra#readme",
  "bugs": {
    "url": "https://github.com/discowd-nitwo/Lyra/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/discowd-nitwo/Lyra.git"
  },
  "license": "ISC",
  "author": "Lily Seymour",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && cp -r src/locales dist/locales",
    "build:win": "tsc && xcopy /E /I /Y src\\locales dist\\locales",
    "start": "node dist/index.js",
    "dev": "npm run build:win && cross-env LOG_LEVEL=debug NODE_ENV=dev npm run start",
    "dev:d": "ts-node src/deploy.ts && npm run dev",
    "deploy": "ts-node src/deploy.ts",
    "cleanup": "rimraf logs && rimraf dev.db",
    "cleanup:dist": "rimraf logs && rimraf dev.db && rimraf dist"
  },
  "dependencies": {
    "@prisma/adapter-libsql": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "axios": "^1.16.1",
    "discord.js": "^14.26.4",
    "dotenv": "^17.4.2",
    "libsql": "^0.5.29",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/axios": "^0.9.36",
    "@types/node": "^25.9.0",
    "@types/winston": "^2.4.4",
    "cross-env": "^10.1.0",
    "prisma": "^7.8.0",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
