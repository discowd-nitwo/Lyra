generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model GuildConfig {
  id                String    @id @default(cuid())
  guildId           String    @unique
  auditLogChannel   String?
  auditLogEnabled   Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  auditLogEvents    AuditLogEvent[]
}

model AuditLogEvent {
  id        String      @id @default(cuid())
  guildId   String
  eventType String
  userId    String?
  targetId  String?
  reason    String?
  metadata  String?     // JSON string for extra data
  createdAt DateTime    @default(now())

  guild     GuildConfig @relation(fields: [guildId], references: [guildId])
}